# Copy to .env.local and fill in. .env.local is gitignored.

# Which AIProvider adapter to use (see lib/ai/index.ts). V1 default: openai.
AI_PROVIDER=openai

# Required when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local dev: leave TURSO_DATABASE_URL/TURSO_AUTH_TOKEN unset and the app
# uses an embedded libSQL file at DATABASE_PATH instead (default ./noesis.db).
DATABASE_PATH=./noesis.db

# Production (e.g. Vercel): point at a hosted Turso database instead — get
# these from `turso db show <db-name> --url` and `turso db tokens create
# <db-name>`. When set, these take priority over DATABASE_PATH.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
